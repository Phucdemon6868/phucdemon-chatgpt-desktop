# Copy thành .env rồi điền. KHÔNG commit file .env!
# Chỉ cần điền nhà cung cấp bạn muốn dùng; để trống = tắt nhà cung cấp đó.

# ── ChatGPT web (cookie) ───────────────────────────────────────────
# F12 → Network → request bất kỳ tới chatgpt.com → header "cookie"
CHATGPT_COOKIE=

# ── OpenAI API chính thức (platform.openai.com) ────────────────────
OPENAI_API_KEY=

# ── Gemini API chính thức (aistudio.google.com) ────────────────────
GEMINI_API_KEY=
# ── Gemini web (cookie gemini.google.com, cần __Secure-1PSID và nên có __Secure-1PSIDTS)
GEMINI_COOKIE=

# ── DeepSeek API chính thức (platform.deepseek.com) ────────────────
DEEPSEEK_API_KEY=
# ── DeepSeek web: F12 → Application → Local Storage → chat.deepseek.com → "userToken"
DEEPSEEK_USER_TOKEN=
# Tùy chọn: chuỗi cookie chat.deepseek.com nếu bị chặn (403)
DEEPSEEK_COOKIE=

# Proxy cho gemini-web / deepseek-web (http://user:pass@host:port), để trống nếu không dùng
WEB_PROXY=

# Model mặc định dạng <nhà cung cấp>/<model>, ví dụ chatgpt/auto, gemini/gemini-2.5-flash,
# deepseek/deepseek-flash, deepseek-web/expert+think. Để trống = tự chọn.
DEFAULT_MODEL=

# Danh sách model dự phòng khi không lấy được từ API (phân tách bằng dấu phẩy)
CHATGPT_MODELS=auto,gpt-4o,gpt-4o-mini,o3-mini,o4-mini
# OPENAI_MODELS=
# GEMINI_MODELS=
# DEEPSEEK_MODELS=deepseek-flash

# Khóa bảo vệ proxy /v1 (để trống = không kiểm tra; nên đặt nếu mở ra ngoài localhost)
PROXY_API_KEY=

# Bản web dùng chat tạm khi qua proxy (ChatGPT/Gemini không lưu vào lịch sử): 1/0
CHATGPT_TEMPORARY_CHAT=1

CHATGPT_DB_PATH=data/chats.db
IMAGE_DIR=data/images
CHATGPT_MAX_RETRIES=3
CHATGPT_TIMEOUT=180
